{
  "name": "@dingcang/dsh-tailnet-ingress",
  "version": "1.2.2",
  "type": "module",
  "description": "Serves the loopback DSH Web UI on the machine's own private, CGNAT and tunnel addresses, following the listener's port.",
  "license": "MIT",
  "homepage": "https://github.com/dingcang/dsh-tailnet-ingress#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingcang/dsh-tailnet-ingress.git"
  },
  "bugs": {
    "url": "https://github.com/dingcang/dsh-tailnet-ingress/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tailscale",
    "shadowrocket",
    "remote-access",
    "tunnel",
    "localhost"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
