{
  "name": "@local/dsh-tailnet-ingress",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Serves the loopback DSH Web UI on the machine's own private, CGNAT and tunnel addresses, following the listener's port.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
